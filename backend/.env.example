# Select local for a local MySQL server or prod for Aiven.
SPRING_PROFILES_ACTIVE=local

# MySQL connection. Do not commit the real password.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=point_of_sale_db
MYSQL_USERNAME=
MYSQL_PASSWORD=

# Required for production; use a strong random value. Optional locally because local has a development fallback.
JWT_SECRET=

# Required for production CORS. Comma-separated origins are supported.
CORS_ALLOWED_ORIGINS=
FRONTEND_URL=

# Optional: Spring Boot uses 8080 when PORT is absent.
PORT=8080
